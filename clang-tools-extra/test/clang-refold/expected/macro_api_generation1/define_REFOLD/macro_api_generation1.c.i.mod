typedef struct { float *data; size_t size; size_t capacity; } array_float_t; array_float_t* array_float_create(size_t initial_capacity); void array_float_destroy(array_float_t *arr); int array_float_push(array_float_t *arr, float value); float array_float_get(array_float_t *arr, size_t index); size_t array_float_size(array_float_t *arr); void array_float_clear(array_float_t *arr);
