// RUN: %clang-refold-tester-verify-off generated_leaf_variadic_activation_keeps_descendant_stringified_observer
// Supplying an omitted variadic actual fails closed when a generated callee's
// unchanged output may observe it.
//
// `FIELD_OPT` stringifies its variadic formal as `""`, and B appends through
// the `__VA_OPT__` tail but keeps that literal.  `FIELD_OPT` is generated by
// `FWD`, and the producer records no `arg_deps` for a callee without its own
// spelling, so nothing proves the unchanged literal independent of the
// rewritten variadic actual.  The invocation is expanded.  This used to emit
// `APPLY(FWD, FIELD_OPT, alpha, 10)`, which re-spells the literal as `"10"`.
#define APPLY(F, G, X, ...) F(G, X, __VA_ARGS__)
#define FWD(G, X, ...) G(X, __VA_ARGS__)
#define FIELD_OPT(name, ...) #__VA_ARGS__ #name __VA_OPT__(":" __VA_ARGS__)
const char *s = "" "alpha" ":" "10";
